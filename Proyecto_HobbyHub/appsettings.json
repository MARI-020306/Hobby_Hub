{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Security": {
    "RateLimits": {
      "LoginAttempts": {
        "PermitLimit": 10,
        "WindowSeconds": 60
      },
      "Registration": {
        "PermitLimit": 5,
        "WindowSeconds": 900
      },
      "AccountRecovery": {
        "PermitLimit": 5,
        "WindowSeconds": 900
      },
      "SocialWrites": {
        "PermitLimit": 60,
        "WindowSeconds": 60
      },
      "Queries": {
        "PermitLimit": 120,
        "WindowSeconds": 60
      },
      "Searches": {
        "PermitLimit": 30,
        "WindowSeconds": 60
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "TechnicalLogs": {
    "MaxFileBytes": 5242880,
    "RetainedFiles": 14,
    "RetentionDays": 14
  }
}
