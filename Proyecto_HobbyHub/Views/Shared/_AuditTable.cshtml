@model List<Proyecto_HobbyHub.Models.AuditoriaSeguridad>
<div class="card table-wrap">@if(Model.Count==0){<p class="empty">No hay registros para mostrar.</p>}else{<table><thead><tr><th>Fecha UTC</th><th>Acción</th><th>Actor</th><th>Objetivo</th><th>Resultado</th></tr></thead><tbody>@foreach(var a in Model){<tr title="Referencia: @a.CorrelacionId | Recurso: @a.TipoRecurso @a.IdRecurso"><td data-label="Fecha UTC">@a.FechaUtc.ToString("yyyy-MM-dd HH:mm")</td><td data-label="Acción">@a.Accion</td><td data-label="Actor">@a.IdActor</td><td data-label="Objetivo">@a.IdObjetivo</td><td data-label="Resultado">@(a.Exito?"Correcto":"Denegado")</td></tr>}</tbody></table>}</div>
