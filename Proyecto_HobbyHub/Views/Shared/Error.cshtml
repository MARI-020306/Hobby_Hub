@model ErrorViewModel
@{ Layout="_AccountLayout"; ViewData["Title"]="No pudimos completar la solicitud"; }
<section class="card" role="alert">
    <p>Inténtalo de nuevo más tarde. Si el problema continúa, comunica este identificador al equipo de soporte.</p>
    @if(Model.ShowRequestId){<p><strong>Identificador de solicitud:</strong> <code>@Model.RequestId</code></p>}
    <a class="button" asp-controller="Social" asp-action="Inicio">Volver al inicio</a>
</section>
