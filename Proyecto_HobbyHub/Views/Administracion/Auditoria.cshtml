@model Proyecto_HobbyHub.ViewModels.SocialPage
@{Layout="_SocialLayout";ViewData["Title"]=Model.Title;}
<h1>Auditoría general</h1><form class="card" method="get"><label for="administracion-auditoria-user-1">Usuario ID</label><input id="administracion-auditoria-user-1" name="user" type="number" min="1" /><label for="administracion-auditoria-action-2">Acción exacta</label><input id="administracion-auditoria-action-2" name="action" maxlength="64" /><label for="administracion-auditoria-from-3">Desde (UTC)</label><input id="administracion-auditoria-from-3" name="from" type="date" /><label for="administracion-auditoria-to-4">Hasta (UTC)</label><input id="administracion-auditoria-to-4" name="to" type="date" /><label for="administracion-auditoria-success-5">Resultado</label><select id="administracion-auditoria-success-5" name="success"><option value="">Todos</option><option value="true">Correcto</option><option value="false">Denegado</option></select><button>Consultar</button></form>
<partial name="_AuditTable" model="Model.Audit" /><partial name="_PageLinks" model="Model" />
