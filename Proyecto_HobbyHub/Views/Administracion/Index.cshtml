@model List<Proyecto_HobbyHub.Models.Usuario>
@{Layout="_SocialLayout";ViewData["Title"]="Administración";var roles=(List<Proyecto_HobbyHub.Models.Role>)ViewBag.Roles;int me=int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);}
<h1>Administración de cuentas</h1><div class="tabs"><a asp-action="Auditoria">Auditoría</a><a asp-action="Comunidades">Comunidades</a><a asp-controller="Moderacion" asp-action="Index">Moderación</a></div><form class="search" method="get"><input name="q" value="@ViewBag.Query" aria-label="Buscar cuentas" /><button>Buscar</button></form>
@foreach(var u in Model){<article class="card"><strong>@u.Nombre · #@u.IdUsuario</strong><p>@u.Rol.Nombre · @u.Estado</p>@if(u.IdUsuario!=me){<form asp-action="Cuenta" method="post"><input type="hidden" name="id" value="@u.IdUsuario" /><label for="administracion-index-role-1-@u.IdUsuario">Rol</label><select id="administracion-index-role-1-@u.IdUsuario" name="role">@foreach(var r in roles){<option value="@r.IdRol" selected="@(r.IdRol==u.RolId)">@r.Nombre</option>}</select><label for="administracion-index-state-2-@u.IdUsuario">Estado</label><select id="administracion-index-state-2-@u.IdUsuario" name="state">@foreach(var state in new[]{"Activo","Suspendido","Bloqueado"}){<option selected="@(state==u.Estado)">@state</option>}</select><button>Guardar cambios y revocar sesiones</button></form>}else{<p class="muted">No puedes modificar tus propios privilegios desde este panel.</p>}</article>}
<nav class="tabs">@if((int)ViewBag.Page>1){<a asp-route-page="@((int)ViewBag.Page-1)" asp-route-q="@ViewBag.Query">Anterior</a>}@if(Model.Count==30){<a asp-route-page="@((int)ViewBag.Page+1)" asp-route-q="@ViewBag.Query">Siguiente</a>}</nav>
