@model Proyecto_HobbyHub.ViewModels.CommunitySettings
@{Layout="_SocialLayout";ViewData["Title"]="Administrar comunidad";var members=(List<Proyecto_HobbyHub.Models.MiembroComunidad>)ViewBag.Members;}
<h1>Administrar @Model.Name</h1><a asp-action="Detalle" asp-route-idComunidad="@Model.Id">Revisar publicaciones</a>
<form asp-action="Administrar" asp-route-id="@Model.Id" method="post" class="card"><div asp-validation-summary="All"></div><input asp-for="Id" type="hidden" /><label asp-for="Name">Nombre</label><input asp-for="Name" /><label asp-for="Description">Descripción</label><textarea asp-for="Description"></textarea><label asp-for="Rules">Reglas</label><textarea asp-for="Rules"></textarea><label asp-for="Category">Categoría</label><select asp-for="Category">@foreach(var c in new[]{"Videojuegos","Música","Fotografía","Maquillaje","Lectura","Deportes","General"}){<option>@c</option>}</select><label><input asp-for="Private" /> Privada: aprobar solicitudes e invitar miembros</label><button>Guardar cambios</button></form>
<h2>Miembros y solicitudes</h2>@foreach(var m in members){<article class="card"><a asp-controller="Social" asp-action="Persona" asp-route-id="@m.IdUsuario">@m.Usuario.Nombre</a><span class="pill">@m.Estado</span><div class="actions">@foreach(var op in m.Estado=="Pendiente"?new[]{"aceptar","expulsar"}:m.Estado=="Bloqueado"?new[]{"desbloquear"}:new[]{"expulsar"}){<form asp-action="Miembro" asp-route-id="@Model.Id" method="post"><input type="hidden" name="user" value="@m.IdUsuario" /><input type="hidden" name="operation" value="@op" /><button class="secondary">@op</button></form>}</div></article>}
<h2>Invitar a una persona</h2><form class="search" method="get" asp-action="Administrar" asp-route-id="@Model.Id"><input name="q" value="@ViewBag.Query" maxlength="100" placeholder="Buscar por nombre" aria-label="Buscar persona para invitar" /><button>Buscar</button></form>
@{var candidates=(List<Proyecto_HobbyHub.ViewModels.PersonCard>)ViewBag.Candidates;}
<form class="card" asp-action="Miembro" asp-route-id="@Model.Id" method="post"><input type="hidden" name="operation" value="invitar" /><label for="candidate">Persona</label><select id="candidate" name="user" required>@foreach(var candidate in candidates){<option value="@candidate.Id">@candidate.Name</option>}</select><button disabled="@(candidates.Count==0)">Enviar invitación</button>@if(candidates.Count==0){<p>No hay personas disponibles con ese nombre.</p>}</form>
