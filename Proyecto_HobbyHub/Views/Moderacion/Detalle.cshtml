@model Proyecto_HobbyHub.Models.Reporte
@{Layout="_SocialLayout";ViewData["Title"]="Reporte #"+Model.IdReporte;}
<h1>Reporte #@Model.IdReporte</h1><section class="card"><span class="pill">@Model.Estado</span><p>@Model.Motivo</p><p>Cuenta reportada #@Model.IdUsuarioReportado</p>@if(Model.IdPublicacionNavigation is not null){<h2>Publicación</h2><p class="post-content">@Model.IdPublicacionNavigation.Contenido</p>}@if(Model.IdComentarioNavigation is not null){<h2>Comentario</h2><p class="post-content">@Model.IdComentarioNavigation.Contenido</p>}@if(Model.Resolucion is not null){<p>Resolución: @Model.Resolucion</p>}@if(Model.Mensaje is not null){<h2>Mensaje reportado</h2><p class="post-content">@Model.Mensaje.Contenido</p>}<div class="gallery">@foreach(var image in (List<Proyecto_HobbyHub.Models.PublicacionImagen>)ViewBag.Images){<img src="@Url.Action("Imagen","Social",new{id=image.IdImagen})" alt="Imagen del contenido reportado" loading="lazy" />}</div></section>
@if(Model.Estado!="Resuelto"){<form class="card" asp-action="Resolver" method="post"><input type="hidden" name="id" value="@Model.IdReporte" /><label for="moderacion-detalle-operation-1">Acción</label><select id="moderacion-detalle-operation-1" name="operation"><option value="revision">Marcar en revisión</option><option value="resolver">Resolver sin ocultar</option><option value="ocultar">Ocultar contenido y resolver</option><option value="suspender">Suspender cuenta y resolver</option></select><label for="moderacion-detalle-days-2">Días de suspensión (si corresponde)</label><input id="moderacion-detalle-days-2" type="number" name="days" value="7" min="1" max="30" /><label for="moderacion-detalle-reason-3">Motivo de la decisión</label><textarea id="moderacion-detalle-reason-3" name="reason" maxlength="500" required></textarea><button>Confirmar acción de moderación</button></form>}
<a asp-action="Index">Volver a reportes</a>
