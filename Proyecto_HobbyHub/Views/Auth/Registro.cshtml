@model Proyecto_HobbyHub.ViewModels.RegistroViewModel

@{
    Layout = null;
    ViewData["Title"] = "Crear cuenta";

}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HobbyHub - Crear cuenta</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/registro.css" />
</head>
<body>
    <main class="auth-container">
        <section class="login-card register-card">
            <div class="login-content">
                <div class="logo">
                    <div class="logo-icon">H</div>
                    <div><h1>HobbyHub</h1></div>
                </div>

                <h2>Crear cuenta</h2>
                <p class="subtitle">Reg&iacute;strate para comenzar a usar HobbyHub</p>

                @if (ViewBag.Error != null)
                {
                    <div class="error-message">@ViewBag.Error</div>
                }

                <form asp-controller="Auth" asp-action="Registro" method="post" id="registerForm">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label asp-for="Nombre">Nombre completo</label>
                        <input asp-for="Nombre" type="text" placeholder="Ingresa tu nombre completo" autocomplete="name" />
                        <span asp-validation-for="Nombre" class="validation-message"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Correo">Correo electr&oacute;nico</label>
                        <input asp-for="Correo" type="email" placeholder="ejemplo@correo.com" autocomplete="email" />
                        <span asp-validation-for="Correo" class="validation-message"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password">Contrase&ntilde;a</label>
                        <input asp-for="Password" type="password" placeholder="Ingresa tu contrase&ntilde;a" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="validation-message"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmarPassword">Confirmar contrase&ntilde;a</label>
                        <input asp-for="ConfirmarPassword" type="password" placeholder="Confirma tu contrase&ntilde;a" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmarPassword" class="validation-message"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Celular">Celular <span class="optional">(Opcional)</span></label>
                        <input asp-for="Celular" type="tel" placeholder="Ingresa tu celular" autocomplete="tel" />
                        <span asp-validation-for="Celular" class="validation-message"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Direccion">Direcci&oacute;n <span class="optional">(Opcional)</span></label>
                        <input asp-for="Direccion" type="text" placeholder="Ingresa tu direcci&oacute;n" autocomplete="street-address" />
                        <span asp-validation-for="Direccion" class="validation-message"></span>
                    </div>

                    <!-- ROL DE LA CUENTA -->
                    <div class="form-group">

                        <label asp-for="RolId">Rol</label>

                        <select asp-for="RolId" asp-items="Model.RolesDisponibles">
                            <option value="">Selecciona tu rol</option>
                        </select>

                        <small class="optional">El rol Creador puede crear y editar sus comunidades.</small>
                        <span asp-validation-for="RolId" class="validation-message"></span>

                    </div>

                    <button type="submit" class="btn-login">Registrarse</button>
                </form>

                <p class="register-text">
                    &iquest;Ya tienes cuenta?
                    <a asp-controller="Auth" asp-action="Login">Inicia sesi&oacute;n</a>
                </p>
            </div>
        </section>
    </main>

    <script src="~/js/auth.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
