@model Proyecto_HobbyHub.ViewModels.SocialPage
@{Layout="_SocialLayout";ViewData["Title"]=Model.Title;}
<h1>Notificaciones</h1><nav class="tabs"><a asp-action="Notificaciones">Todas</a><a asp-action="Notificaciones" asp-route-unread="true">Sin leer</a><a asp-action="Ajustes">Preferencias</a></nav>
@foreach(var n in Model.Notices){<article class="card"><strong>@n.Tipo</strong><p class="muted">@n.FechaUtc.ToLocalTime().ToString("dd MMM HH:mm") · @(n.Leida?"Leída":"Nueva")</p>
@if(n.Tipo is "Publicacion" or "Comentario" or "Respuesta" or "Like"){<a asp-action="Publicacion" asp-route-id="@n.IdRecurso">Ver publicación</a>}else if(n.Tipo is "Miembro" or "SolicitudComunidad"){<a asp-controller="Comunidades" asp-action="Administrar" asp-route-id="@n.IdRecurso">Gestionar miembros</a>}else if(n.Tipo=="ComunidadAceptada"){<a asp-controller="Comunidades" asp-action="Detalle" asp-route-idComunidad="@n.IdRecurso">Ver comunidad</a>}else if(n.Tipo=="Mensaje"){<a asp-action="Mensajes" asp-route-id="@n.IdRecurso">Ver conversación</a>}else if(n.Tipo=="Invitacion"){<form asp-controller="Comunidades" asp-action="Unirse" asp-route-idComunidad="@n.IdRecurso" method="post"><button>Aceptar invitación</button></form>}else if(n.Tipo=="ReporteRevisado"){<a asp-action="Reportes">Ver estado de mi reporte</a>}else{<a asp-action="Persona" asp-route-id="@n.IdRecurso">Ver perfil</a>}
@if(!n.Leida){<form asp-action="LeerNotificacion" method="post"><input type="hidden" name="id" value="@n.IdNotificacion" /><button class="secondary">Marcar como leída</button></form>}</article>}
@if(Model.Notices.Count==0){<p class="empty">Estás al día.</p>}<partial name="_PageLinks" model="Model" />
