@model Proyecto_HobbyHub.ViewModels.SocialPage
@{Layout="_SocialLayout";ViewData["Title"]=Model.Title;var person=Model.Profile!;int me=int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);}
<section class="card">@if(Model.CanSeeProfile){<img class="profile-cover" src="@(person.Cover??Url.Content("~/images/cover-default.svg"))" alt="Portada de perfil" /><img class="profile-avatar" src="@(person.Photo??Url.Content("~/images/avatar-default.svg"))" alt="Fotografía de perfil" />}<h1>@person.Name</h1><p>@person.Bio</p><div class="tabs"><span class="pill">@Model.Followers seguidores</span><span class="pill">@Model.FollowingCount siguiendo</span><span class="pill">@(person.Private?"Privado":"Público")</span></div>
@if(person.Id!=me){<div class="actions"><form asp-action="Seguir" method="post"><input type="hidden" name="id" value="@person.Id" /><button>@(Model.Following==true?"Dejar de seguir":Model.Following==false?"Cancelar solicitud":"Seguir")</button></form><a class="button secondary" asp-action="Mensajes" asp-route-id="@person.Id">Enviar mensaje</a></div><form asp-action="Bloquear" method="post"><input type="hidden" name="id" value="@person.Id" /><button class="danger">Bloquear persona</button></form><details><summary>Reportar cuenta</summary><form asp-action="Reportar" method="post"><input type="hidden" name="type" value="usuario" /><input type="hidden" name="id" value="@person.Id" /><label for="social-persona-reason-1">Motivo</label><input id="social-persona-reason-1" name="reason" maxlength="255" required /><button>Reportar</button></form></details>}else{<a class="button" asp-action="Ajustes">Editar preferencias y biografía</a>}</section>
@if(!Model.CanSeeProfile){<p class="empty">Este perfil es privado. Solicita seguirlo para ver sus publicaciones.</p>}else{foreach(var post in Model.Posts){<partial name="_PostCard" model="post" />}<partial name="_PageLinks" model="Model" />}
