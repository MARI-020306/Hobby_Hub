@model Proyecto_HobbyHub.ViewModels.SocialPage
@{Layout="_SocialLayout";ViewData["Title"]=Model.Title;var card=Model.Posts.Single();var p=card.Post;int me=int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);}
<h1>Publicación</h1><partial name="_PostCard" model="card" />
@if(p.IdUsuario==me&&card.Images.Count>0){<details class="card"><summary>Administrar fotografías</summary>@foreach(var photo in card.Images){<form asp-action="RetirarImagen" method="post"><input type="hidden" name="id" value="@photo.IdImagen" /><button class="secondary">Retirar fotografía @(photo.Orden+1)</button></form>}</details>}
@if(p.IdUsuario==me){<details class="card"><summary>Editar mi publicación</summary><form asp-controller="Comunidades" asp-action="EditarPublicacion" asp-route-idPublicacion="@p.IdPublicacion" method="post"><input type="hidden" name="IdComunidad" value="@p.IdComunidad" /><label for="social-publicacion-Contenido-1">Contenido</label><textarea id="social-publicacion-Contenido-1" name="Contenido" maxlength="2000" required>@p.Contenido</textarea><button>Guardar cambios</button></form><form asp-controller="Comunidades" asp-action="EliminarPublicacion" asp-route-idPublicacion="@p.IdPublicacion" method="post"><input type="hidden" name="idComunidad" value="@p.IdComunidad" /><button class="danger">Retirar publicación</button></form></details>}
<section class="card"><h2>Comentarios y respuestas</h2><form asp-action="Comentar" method="post"><input type="hidden" name="id" value="@p.IdPublicacion" /><label for="comment">Tu comentario</label><textarea id="comment" name="content" maxlength="1000" required></textarea><button>Comentar</button></form>
@foreach(var c in card.Comments.Take(50)){<article class="comment @(c.IdComentarioPadre.HasValue?"reply":"")"><a asp-action="Persona" asp-route-id="@c.IdUsuario"><strong>@c.IdUsuarioNavigation.Nombre</strong></a>@if(c.IdComentarioPadre.HasValue){<small> · Respuesta a #@c.IdComentarioPadre</small>}<p class="post-content">@c.Contenido</p><details><summary>Responder</summary><form asp-action="Comentar" method="post"><input type="hidden" name="id" value="@p.IdPublicacion" /><input type="hidden" name="parent" value="@c.IdComentario" /><textarea name="content" maxlength="1000" aria-label="Respuesta" required></textarea><button>Enviar respuesta</button></form></details>
@if(c.IdUsuario==me){<form asp-action="RetirarComentario" method="post"><input type="hidden" name="id" value="@c.IdComentario" /><button class="secondary">Retirar comentario</button></form>}else{<details><summary>Reportar comentario</summary><form asp-action="Reportar" method="post"><input type="hidden" name="type" value="comentario" /><input type="hidden" name="id" value="@c.IdComentario" /><input name="reason" maxlength="255" required aria-label="Motivo del reporte" /><button>Enviar reporte</button></form></details>}</article>}
</section><partial name="_PageLinks" model="Model" />
@if(p.IdUsuario!=me){<details class="card"><summary>Reportar publicación</summary><form asp-action="Reportar" method="post"><input type="hidden" name="type" value="publicacion" /><input type="hidden" name="id" value="@p.IdPublicacion" /><label for="social-publicacion-reason-2">Motivo</label><input id="social-publicacion-reason-2" name="reason" required maxlength="255" /><button>Enviar reporte</button></form></details>}
