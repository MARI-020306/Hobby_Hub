@model Proyecto_HobbyHub.ViewModels.SocialPage
@{Layout="_SocialLayout";ViewData["Title"]=Model.Title;int me=int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);}
<h1>@Model.Title</h1>
@if(Model.UserId==0){<p class="muted">Elige una conversación o busca una persona para escribirle.</p><div class="grid">@foreach(var person in Model.People.Where(p=>p.Id!=me)){<a class="card" asp-action="Mensajes" asp-route-id="@person.Id">@person.Name</a>}</div><a asp-action="Explorar">Encontrar personas</a>}
else{<section class="card"><h2>@Model.People.Single(p=>p.Id==Model.UserId).Name</h2><a asp-action="Bloqueados">Gestionar bloqueos</a><form asp-action="Bloquear" method="post"><input type="hidden" name="id" value="@Model.UserId" /><button class="danger">Bloquear persona</button></form>@foreach(var message in Model.Messages){<article class="chat-message @(message.IdRemitente==me?"mine":"")"><p>@message.Contenido</p><time>@message.FechaUtc.ToLocalTime().ToString("dd MMM HH:mm")</time><small> @(message.LeidoUtc.HasValue?"Leído":"Enviado")</small>@if(message.IdRemitente!=me){<details><summary>Reportar mensaje</summary><form asp-action="ReportarMensaje" method="post"><input type="hidden" name="id" value="@message.IdMensaje" /><label for="social-mensajes-reason-1-@message.IdMensaje">Motivo</label><input id="social-mensajes-reason-1-@message.IdMensaje" name="reason" maxlength="255" required /><button>Enviar reporte</button></form></details>}</article>}@if(Model.CanSend){<form asp-action="Enviar" method="post"><input type="hidden" name="id" value="@Model.UserId" /><label for="social-mensajes-content-2">Mensaje</label><textarea id="social-mensajes-content-2" name="content" maxlength="2000" required></textarea><button>Enviar</button></form>}else{<p class="muted">La privacidad o el estado de la cuenta no permiten nuevos mensajes.</p>}<form asp-action="LeerMensajes" method="post"><input type="hidden" name="id" value="@Model.UserId" /><button class="secondary">Marcar conversación como leída</button></form></section>}
<partial name="_PageLinks" model="Model" />
