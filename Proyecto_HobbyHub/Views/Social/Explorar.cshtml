@model Proyecto_HobbyHub.ViewModels.SocialPage
@{Layout="_SocialLayout";ViewData["Title"]=Model.Title;var membershipStates=(Dictionary<int,string>)ViewBag.MembershipStates;int me=int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);}
<h1>Explora tus intereses</h1><form class="search" method="get"><input name="q" value="@Model.Query" maxlength="100" aria-label="Buscar hobbies, personas o publicaciones" placeholder="Fotografía, música, videojuegos…" /><button>Buscar</button></form>
<h2>Personas</h2><div class="grid">@foreach(var person in Model.People){<article class="card"><a asp-action="Persona" asp-route-id="@person.Id"><strong>@person.Name</strong></a><p>@person.Bio</p><span class="muted">@(person.Private?"Perfil privado":"Perfil público") · #@person.Id</span></article>}</div>
<h2>Comunidades</h2><div class="grid">@foreach(var c in Model.Communities){<article class="card"><h3>@c.Nombre</h3><p>@c.Descripcion</p><span class="pill">@c.Categoria · @(c.Privada?"Privada":"Pública")</span><p>@if(c.Privada){<a asp-controller="Comunidades" asp-action="Index" asp-route-busqueda="@c.Nombre">Ver comunidad y membresía</a>}else{<a asp-controller="Comunidades" asp-action="Detalle" asp-route-idComunidad="@c.IdComunidad">Ver comunidad</a>}</p>@{var state=membershipStates.GetValueOrDefault(c.IdComunidad);}@if(c.IdCreador==me||state=="Aceptado"){<span class="pill">@(c.IdCreador==me?"Tu comunidad":"Miembro")</span>}else if(state is "Pendiente" or "Bloqueado"){<span class="pill">@(state=="Pendiente"?"Solicitud pendiente":"Membresía bloqueada")</span>}else{<form asp-controller="Comunidades" asp-action="Unirse" asp-route-idComunidad="@c.IdComunidad" method="post"><button>@(state=="Invitado"?"Aceptar invitación":c.Privada?"Solicitar ingreso":"Unirme")</button></form>}</article>}</div>
<h2>Publicaciones</h2>@foreach(var post in Model.Posts){<partial name="_PostCard" model="post" />}
<partial name="_PageLinks" model="Model" />
