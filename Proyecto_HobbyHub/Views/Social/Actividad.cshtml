@model Proyecto_HobbyHub.ViewModels.SocialPage
@{Layout="_SocialLayout";ViewData["Title"]=Model.Title;}
<h1>Actividad y sesiones</h1><nav class="tabs"><a asp-action="Persona" asp-route-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value">Mis publicaciones</a><a asp-action="Reacciones">Mis likes</a><a asp-action="Guardados">Guardados</a><a asp-action="MisComentarios">Mis comentarios</a></nav><section class="card"><h2>Sesiones abiertas</h2>@foreach(var s in Model.Sessions){<form asp-action="CerrarSesion" method="post"><input type="hidden" name="id" value="@s.IdSesion" /><p>Inicio @s.FechaCreacionUtc.ToLocalTime().ToString("dd MMM HH:mm") · Caduca @s.ExpiraUtc.ToLocalTime().ToString("dd MMM HH:mm")</p><button class="secondary">Cerrar esta sesión</button></form>}<a asp-controller="Cuenta" asp-action="Seguridad">Cambiar contraseña o cerrar todas las sesiones</a></section>
<h2>Tu actividad de seguridad</h2><partial name="_AuditTable" model="Model.Audit" /><partial name="_PageLinks" model="Model" />
