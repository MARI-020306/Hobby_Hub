@model Proyecto_HobbyHub.ViewModels.Perfil.EditarPerfilViewModel

@{
    Layout = "_SocialLayout";
    ViewData["Title"] = "Editar perfil";
}

@section Styles {<link rel="stylesheet" href="~/css/perfil.css" asp-append-version="true" />}
    <div class="edit-page">
        <section class="edit-card">
            <a class="back-link" asp-controller="Perfil" asp-action="Index">
                <span class="material-symbols-outlined">arrow_back</span>
                Volver al perfil
            </a>

            <header>
                <h1>Editar perfil</h1>
                <p>Los datos personales protegidos no se muestran. Escribe un valor solo si deseas reemplazarlo.</p>
            </header>

            <form asp-controller="Perfil" asp-action="Editar" method="post" class="edit-form">
                @Html.AntiForgeryToken()

                <div class="validation-summary" asp-validation-summary="ModelOnly"></div>

                <div class="field-group">
                    <label asp-for="Nombre">Nombre</label>
                    <input asp-for="Nombre" autocomplete="name" />
                    <span asp-validation-for="Nombre"></span>
                </div>

                <div class="field-grid">
                    <div class="field-group">
                        <label asp-for="Celular">Celular</label>
                        <input asp-for="Celular" autocomplete="tel" placeholder="Nuevo celular (opcional)" />
                        <span asp-validation-for="Celular"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="Direccion">Direccion</label>
                        <input asp-for="Direccion" autocomplete="street-address" placeholder="Nueva dirección (opcional)" />
                        <span asp-validation-for="Direccion"></span>
                    </div>
                </div>

                <div class="field-group">
                    <label asp-for="ImagenPerfilUrl">URL de imagen de perfil</label>
                    <p>Las fotografías subidas se conservan al dejar estos campos vacíos. Puedes reemplazarlas desde <a asp-controller="Social" asp-action="Ajustes">Configuración</a>.</p>
                    <input asp-for="ImagenPerfilUrl" placeholder="https://..." />
                    <span asp-validation-for="ImagenPerfilUrl"></span>
                </div>

                <div class="field-group">
                    <label asp-for="PortadaUrl">URL de portada</label>
                    <input asp-for="PortadaUrl" placeholder="https://..." />
                    <span asp-validation-for="PortadaUrl"></span>
                </div>

                <div class="edit-actions">
                    <a class="secondary-button" asp-controller="Perfil" asp-action="Index">Cancelar</a>
                    <button type="submit" class="primary-button">
                        <span class="material-symbols-outlined">save</span>
                        Guardar cambios
                    </button>
                </div>
            </form>
        </section>
    </div>
